<!doctype html>
<html lang='{{ request.locale.iso_code }}'>
  <head>
    {% comment %}
      LAYOUT: Theme shell
      PURPOSE: Load global metadata, stylesheets, storefront scripts, and shared wrappers.
      CMS DEPENDENCIES: Global theme settings and page-level Shopify objects.
      SNIPPETS USED: meta-tags, css-variables, home-marketing-structured-data
      LAST UPDATED: 2026-03-20
      NOTES: Kept asset load order intact while removing duplicate wrappers and duplicate script loads.
    {% endcomment %}

    {% render 'meta-tags' %}

    <link
      rel='preconnect'
      href='https://cdn.shopify.com'
      crossorigin
    >
    <link
      rel='preconnect'
      href='https://cdn.prod.website-files.com'
      crossorigin
    >
    <link
      rel='preconnect'
      href='https://d3e54v103j8qbb.cloudfront.net'
      crossorigin
    >

    {% render 'home-marketing-structured-data' %}

    <script type='text/javascript'>
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        ((n.className += t + 'js'),
          ('ontouchstart' in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + 'touch'));
      })(window, document);
    </script>

    <link
      href='{{ 'favicon.png' | asset_url }}'
      rel='shortcut icon'
      type='image/x-icon'
    >
    <link href='{{ 'webclip.png' | asset_url }}' rel='apple-touch-icon'>

    {% render 'css-variables' %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {{ 'normalize.css' | asset_url | stylesheet_tag }}
    {{ 'webflow.css' | asset_url | stylesheet_tag }}
    {{ 'statue-of-wisdom.css' | asset_url | stylesheet_tag }}
    {{ 'extensions.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>
  <body class='body'>
    <div class='page-wrapper'>
      <main class='main-wrapper'>
        {% unless request.page_type == '404' %}
          {% section 'nav' %}
        {% endunless %}

        {{ content_for_layout }}
      </main>
    </div>

    <div class='blur-component'></div>

    <script
      src='https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67e1854c2284fc148a18b804'
      type='text/javascript'
      integrity='sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0='
      crossorigin='anonymous'
      defer
    ></script>
    <script
      src='{{ 'extensions.js' | asset_url }}'
      type='text/javascript'
      defer
    ></script>
    <script
      src='{{ 'webflow.js' | asset_url }}'
      type='text/javascript'
      defer
    ></script>
    <script
      src='{{ 'custom.js' | asset_url }}'
      type='text/javascript'
      defer
    ></script>
  </body>
</html>
