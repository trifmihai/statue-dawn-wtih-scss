<div class='page-wrapper'>
  <section class='section_404'>
    <div class='padding-global is-404'>
      <div class='container-large is-404'>
        <div class='max-width-large'>
          <div class='_404-page_wrapper'>
            {% render 'section-corners' %}
            <div data-figma-id='8960:6589' class='_404_wrapper'>
              <a href='{{ routes.root_url }}' class='_404_logo-link w-nav-brand'>
                <img
                  loading='lazy'
                  src='{{ 'statue-logo.svg' | asset_url }}'
                  alt=''
                  class='_404_logo'
                >
              </a>
              <div data-figma-id='8960:6599' class='_404_content-wrapper'>
                <div data-figma-id='8960:6600' class='_404_header'>
                  <h1 data-figma-id='8960:6601' class='heading-style-h4 is-404'>
                    <span>Oops, nothing here...</span>
                  </h1>
                  <p data-figma-id='8960:6602' class='text-size-medium text-align-center'>
                    Looks like this page might have moved or never existed. Either way, home is just a click away.
                  </p>
                </div>
                {% render 'cta-button', href: routes.root_url, text: 'Take me home', button_classes: 'is-404' %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
