<div
  data-collapse='medium'
  data-animation='over-right'
  data-duration='400'
  fs-scrolldisable-element='smart-nav'
  data-easing='ease'
  data-easing2='ease'
  role='banner'
  class='navbar_component w-nav'>
  <div class='container-large'>
    <div class='nav_component'>
      <div class='nav_wrapper'>
        <div class='nav-content'>
          <a
            href="{{ routes.root_url }}"
            aria-current='page'
            class='navbar_logo-link w-nav-brand w--current'>
            <img
              width="132"
              height="30"
              alt=""
              src="{{ 'statue-logo.svg' | asset_url }}"
              loading="lazy"
              class="navbar_logo" />
          </a>
          <div class='navbar_links'>
            <div class='navbar_link-wrapper'>
              <a href='#section-hero' class='navbar_link w-nav-link'>Home</a>
            </div>
            <div class='navbar_link-wrapper'>
              <a href='#section-summary' class='navbar_link w-nav-link'>Summary</a>
            </div>
            <div class='navbar_link-wrapper'>
              <a href='#section-pricing' class='navbar_link w-nav-link'>Pricing</a>
            </div>
            <div class='navbar_link-wrapper'>
              <a href='#section-faq' class='navbar_link w-nav-link'>FAQ</a>
            </div>
          </div>
          <div class='navbar_cta-group'>
            <div class='navbar_cart-wrapper'>
              <a href="{{ routes.cart_url }}" class="navbar_cart-link w-nav-link" id="cart-icon-bubble">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-bag"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                <div class="cart-count-bubble" data-cart-count="{{ cart.item_count }}" style="{% if cart.item_count == 0 %}display: none;{% endif %}">
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                  <span class="visually-hidden">items in cart</span>
                </div>
              </a>
            </div>
            <div class='navbar_button-wrapper'>
              <a href='#section-pricing' class='button is-default w-inline-block'>
                <div class='button_line is-top'></div>
                <div class='button_content is-nav'>
                  <div class='text-size-regular is-primary'>Get Pack</div>
                </div>
                <div class='button_line is-bottom'></div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Update cart bubble count dynamically
  function updateCartBubble(count) {
    const bubble = document.querySelector('.cart-count-bubble');
    if (!bubble) return;
    
    const countSpan = bubble.querySelector('span[aria-hidden="true"]');
    if (countSpan) {
      countSpan.textContent = count;
    }
    
    // Show/hide based on count
    if (count > 0) {
      bubble.style.display = 'flex';
    } else {
      bubble.style.display = 'none';
    }
  }

  // Listen for Shopify cart events
  document.addEventListener('cart:updated', function(event) {
    const count = event.detail?.cart?.item_count ?? event.detail?.item_count ?? 0;
    updateCartBubble(count);
  });

  // Fallback: Poll cart API for changes (for apps that don't fire events)
  let lastCartCount = {{ cart.item_count }};
  
  async function checkCartCount() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();
      if (cart.item_count !== lastCartCount) {
        lastCartCount = cart.item_count;
        updateCartBubble(cart.item_count);
      }
    } catch (e) {
      // Silently fail
    }
  }

  // Check every 2 seconds for cart changes
  setInterval(checkCartCount, 2000);
</script>