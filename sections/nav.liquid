{% comment %}
  SECTION: Navigation
  PURPOSE: Render the persistent landing-page navigation, cart access, and primary CTA.
  CMS DEPENDENCIES: Global theme setting `settings.cta_primary`, Shopify cart object, Shopify routes.
  SNIPPETS USED: cta-button
  LAST UPDATED: 2026-03-20
  NOTES: Cart bubble behavior is initialized from `assets/custom.js` via data attributes.
{% endcomment %}

<div
  data-collapse='medium'
  data-animation='over-right'
  data-duration='400'
  data-easing='ease'
  data-easing2='ease'
  data-nav-root
  fs-scrolldisable-element='smart-nav'
  role='banner'
  class='navbar_component w-nav'
>
  <div class='container-large'>
    <div class='nav_component'>
      <div class='nav_wrapper'>
        <div class='nav-content'>
          <a
            href='{{ routes.root_url }}'
            aria-current='page'
            aria-label='Musashi Challenge home'
            class='navbar_logo-link w-nav-brand w--current'
          >
            <img
              width='132'
              height='30'
              alt=''
              src='{{ 'statue-logo.svg' | asset_url }}'
              loading='lazy'
              class='navbar_logo'
            >
          </a>

          <div class='navbar_links'>
            <div class='navbar_link-wrapper'>
              <a href='#section-hero' class='navbar_link w-nav-link'>Home</a>
            </div>
            <div class='navbar_link-wrapper'>
              <a href='#section-summary' class='navbar_link w-nav-link'>Summary</a>
            </div>
            <div class='navbar_link-wrapper'>
              <a href='#section-pricing' class='navbar_link w-nav-link'>Pricing</a>
            </div>
            <div class='navbar_link-wrapper'>
              <a href='#section-faq' class='navbar_link w-nav-link'>FAQ</a>
            </div>
          </div>

          <div class='navbar_cta-group'>
            <div class='navbar_cart-wrapper'>
              <a
                href='{{ routes.cart_url }}'
                class='navbar_cart-link w-nav-link'
                id='cart-icon-bubble'
                aria-label='Open cart'
              >
                <img
                  src='{{ 'shopping-bag.svg' | asset_url }}'
                  alt='Shopping cart'
                  width='28'
                  height='28'
                  class='navbar_cart-icon'
                >
                <div
                  class='cart-count-bubble'
                  data-cart-count='{{ cart.item_count }}'
                  data-cart-count-bubble
                  {% if cart.item_count == 0 %}
                    hidden
                  {% endif %}
                >
                  <span aria-hidden='true' data-cart-count-value>{{ cart.item_count }}</span>
                  <span class='visually-hidden'>items in cart</span>
                </div>
              </a>
            </div>

            <div class='navbar_button-wrapper'>
              {% render 'cta-button',
                href: '#section-pricing',
                text: settings.cta_primary,
                button_classes: '',
                content_classes: 'is-nav'
              %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
