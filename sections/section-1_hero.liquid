<section id='section-hero' class='section_hero'>
  <div class='padding-global'>
    <div class='container-large is-line'>
      <div class='line-wrapper is-desktop'>
        <div class='line-long'></div>
        <div class='line-short'></div>
        <div class='line-long'></div>
      </div>
      <div class='line-wrapper is-mobile'>
        <div class='line-long is-mobile'></div>
      </div>
      <div class='content-wrapper'>
        <div data-figma-id='8779:19256' class='hero_header'>
          <div class='hero_top'>
            <div class='hero_tag'>
              <div class='hero_badge-wrapper'>
                <div class='hero_badge'>
                  <p class='text-size-small is-hero-tag'>LIMITED</p>
                </div>
              </div>
              <p class='text-size-regular is-badge'>
                <strong>FREE</strong>
                SHIPPING
                <strong>OVER $50</strong>
              </p>
            </div>
            <div class='max-width-xlarge is-hero-heading'>
              <h1 class='heading-style-h2 text-align-center'>
                <span>{{ settings.hero_title }}</span>
              </h1>
            </div>
          </div>
          <div class='hero_image-wrapper'>
            <img
              src='{{ 'hero-image_mobile-responsive.webp' | asset_url }}'
              loading='lazy'
              alt='{{ section.settings.hero_image_mobile_alt }}'
              class='hero-image is-hide-on-desktop'
            >
          </div>
          <div data-figma-id='8779:19264' class='hero_bottom'>
            <div class='max-width-small'>
              <div data-figma-id='8779:19265' class='hero_description text-align-center'>
                <p class='text-size-medium'>
                  <strong>The life you want</strong>
                  depends on the discipline you build. Install this guided path to
                  <strong>make it permanent.</strong>
                </p>
              </div>
            </div>
            <div class='hero_button-wrapper'>
              {% render 'cta-button', href: '#section-pricing', text: settings.cta_primary %}
              {% render 'cta-button', href: '#section-lead-gen', text: settings.cta_secondary, variant: 'secondary' %}
            </div>
          </div>
        </div>
        <div class='spacer-xxlarge'></div>
        <div class='image-wrapper hero_visual-wrapper'>
          <div class='hero_cover-root' data-sn-hero-cover-root>
            <div class='hero_cover-hit-area' data-sn-hero-cover-hit-area>
              <div class='hero_cover-stage' data-sn-hero-cover-stage>
                <img
                  src='{{ 'book-cover-animation.webp' | asset_url }}'
                  loading='eager'
                  fetchpriority='high'
                  decoding='async'
                  alt='{{ section.settings.hero_image_alt }}'
                  class='hero_cover-image'
                  data-sn-hero-cover-image
                >
              </div>
            </div>
          </div>
          <div class='hero_visual'>
            <img
              src='{{ 'hero-image.webp' | asset_url }}'
              loading='lazy'
              alt=''
              class='main-image is-hero'
            >
            <div class='hero_benefits' aria-hidden='true'>
              <img
                src='{{ 'hero_benefit-1.png' | asset_url }}'
                alt=''
                width='418'
                height='165'
                loading='eager'
                fetchpriority='low'
                decoding='async'
                class='hero_benefit is-benefit-1'
              >
              <img
                src='{{ 'hero_benefit-2.png' | asset_url }}'
                alt=''
                width='470'
                height='161'
                loading='eager'
                fetchpriority='low'
                decoding='async'
                class='hero_benefit is-benefit-2'
              >
              <img
                src='{{ 'hero_benefit-3.png' | asset_url }}'
                alt=''
                width='454'
                height='160'
                loading='eager'
                fetchpriority='low'
                decoding='async'
                class='hero_benefit is-benefit-3'
              >
            </div>
            <div class='visually-hidden'>Hero benefits: Sharpen Skills, See Progress, Build Proof.</div>
          </div>
        </div>

        <div class='spacer-xxlarge hide-mobile-portrait'></div>
      </div>
      <div class='line-wrapper is-desktop'>
        <div class='line-long'></div>
        <div class='line-short'></div>
        <div class='line-long'></div>
      </div>
      <div class='line-wrapper is-mobile'>
        <div class='line-long is-mobile'></div>
      </div>
    </div>
  </div>
</section>

<!-- Your section's HTML and Liquid code here -->
{% schema %}
{
  "name": "Section: Hero",
  "settings": [
    {
      "type": "header",
      "content": "Accessibility (Alt Text)"
    },
    {
      "type": "text",
      "id": "hero_image_mobile_alt",
      "label": "Alt Text: mobile_hero-image",
      "default": "Cover of The Musashi Challenge book with subtitle '5 Weeks To Build Discipline That Doesn't Break' by Shelby CRC, shown in front of open pages with text and illustration."
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Alt Text: desktop_hero-image",
      "default": "Cover of The Musashi Challenge book with subtitle '5 Weeks To Build Discipline That Doesn't Break' by Shelby CRC, shown in front of open pages with text and illustration."
    }
  ],
  "presets": [
    {
      "name": "Section: Hero"
    }
  ]
}
{% endschema %}
