<style>
  /* =============================================
     Section: Stakes Narrative (section-2-1)
     Layout-only CSS — typography via global utility classes
     ============================================= */

  .section_stakes {
    --sn-path-title-width: min(calc(100% - 4rem), 37.5rem);
  }

  .sn_trap-card,
  .sn_path-title {
    box-sizing: border-box;
  }

  /* ---------- Old Way Card ---------- */
  .sn_trap-card {
    background-color: var(--neutral--100);
    border: 1px solid var(--neutral--400);
    width: var(--sn-path-title-width);
    max-width: 100%;
    margin-inline: auto;
    padding: 1.5rem 0.75rem 0.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* heading-style-h6.is-stakes gives Playfair + 1.75rem + w600;
     override font-size to h5-scale for the 2rem Figma spec */
  .sn_card-title {
    font-size: var(--_responsive---heading-size--h5);
    line-height: var(--_responsive---heading-line-height--h5);
    margin: 0;
  }

  .heading-style-h6.is-stakes {
    text-align: center;
    font-weight: 600;
  }

  .sn_trap-inner {
    width: 100%;
    background-color: white;
    border: 1px solid var(--neutral--300);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .sn_trap-list {
    gap: 0.25rem;
    align-items: stretch;
  }

  .sn_trap-item-copy {
    flex: 1;
  }

  .sn_trap-note {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }

  /* New highlight labels: this file already uses inline callout markup in the copy */
  .sn_inline-label {
    display: inline-flex;
    align-items: center;
    padding: 0 0.25rem;
    color: var(--color--text--dark--primary);
    font-weight: 600;
  }

  .sn_inline-label.is-trap {
    background-color: #fdc6c2;
  }

  .sn_inline-label.is-path {
    background-color: var(--brand--100);
  }

  /* ---------- Speech Bubble Row ---------- */
  .sn_speech-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }

  .sn_you-tag {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  /* text-weight-medium + text-align-center on element;
     only custom font-size (0.66rem) kept here */
  .sn_you-tag-text {
    font-size: 0.66rem;
    position: relative;
    z-index: 1;
  }

  .sn_tag-line {
    position: absolute;
    background-color: var(--brand--500);
  }

  .sn_tag-line.is-top {
    top: 0;
    left: -4px;
    right: -4px;
    height: 1px;
  }

  .sn_tag-line.is-bottom {
    bottom: 0;
    left: -4px;
    right: -4px;
    height: 1px;
  }

  .sn_tag-line.is-left {
    left: 0;
    top: -4px;
    bottom: -4px;
    width: 1px;
  }

  .sn_tag-line.is-right {
    right: 0;
    top: -4px;
    bottom: -4px;
    width: 1px;
  }

  .sn_speech-bubble {
    background-color: white;
    border: 1px solid var(--neutral--400);
    padding: 0.75rem 1.5rem;
    width: 241px;
    text-align: center;
  }

  .sn_speech-bubble.is-left-aligned {
    text-align: left;
  }

  /* ---------- Cycle / Warning Box ---------- */
  .sn_cycle-box {
    background-color: white;
    border: 1px solid var(--neutral--300);
    padding: 1.5rem 2rem;
    width: 100%;
    text-align: center;
  }

  /* text-size-medium text-weight-bold text-align-center on element;
     only custom color kept here */
  .sn_cycle-copy {
    color: #9c4a44;
  }

  /* ---------- Vertical Connectors ---------- */
  .sn_vline {
    display: block;
    width: 1px;
    height: 64px;
    flex-shrink: 0;
    overflow: visible;
  }

  /* ---------- Transition Card ---------- */
  .sn_answer-card {
    background-color: white;
    border: 1px solid var(--neutral--400);
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: 28.875rem;
    width: 100%;
  }

  .sn_answer-body {
    white-space: normal;
  }

  /* ---------- Musashi Way ---------- */
  .sn_musashi {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    width: 100%;
    max-width: 1086px;
  }

  .sn_path-title {
    width: min(calc(100% - 4rem), 37.5rem);
    max-width: none;
    padding: 0.75rem;
    background-color: var(--brand--50);
    border: 1px solid var(--brand--300);
    box-shadow: 0 1px 2px rgba(34, 34, 34, 0.05);
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  .sn_path-title-inner {
    width: 100%;
    background-color: white;
    border: 1px solid var(--brand--500);
    padding: 1.5rem;
    position: relative;
  }

  .sn_panel-title {
    color: var(--color--text--dark--primary);
    font-family: var(--_typography---h-root_size--primary-font);
    font-size: var(--_responsive---heading-size--h5);
    line-height: var(--_responsive---heading-line-height--h5);
    font-weight: 600;
    text-align: center;
    margin: 0;
  }

  /* ---------- Steps Area ---------- */
  .sn_steps-area {
    position: relative;
    width: 100%;
    padding: 2rem 0 4rem;
    display: flex;
    justify-content: center;
  }

  .sn_steps-bg {
    position: relative;
    width: 74%;
    margin: 0 auto;
    padding: 0 3rem;
    background-color: #fdfdfb;
    border: 1px solid var(--brand--300);
    box-sizing: border-box;
    z-index: 0;
    display: flex;
    justify-content: center;
  }

  .sn_curves-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    top: -10%;
    display: block;
  }

  .sn_curves-path,
  .sn_vline-path {
    fill: none;
    stroke: #b6934d;
    stroke-width: 1;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    stroke-miterlimit: 1.01111;
    stroke-dasharray: 8 8;
    vector-effect: non-scaling-stroke;
    shape-rendering: geometricPrecision;
  }

  .sn_curves-clip {
    position: absolute;
    inset: 0;
    left: -14px;
    top: 10px;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }

  /* New layout wrapper: keeps the step copy in one vertical column while polaroids alternate around it */
  .sn_steps-list {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 24.1875rem;
    margin: 0 auto;
    padding: 8rem 0 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
  }

  /* ---------- Step Row ---------- */
  .sn_step {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 15rem;
    padding: 0;
  }

  /* ---------- Step Content ---------- */
  .sn_step-text {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    max-width: 24.1875rem;
    position: relative;
    z-index: 3;
  }

  .sn_step-badge {
    background-color: var(--brand--50);
    border: 1px solid var(--neutral--400);
    width: 32px;
    min-width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }

  .sn_step-badge span {
    position: relative;
    z-index: 1;
  }

  .sn_badge-line {
    position: absolute;
    background-color: var(--brand--500);
  }

  .sn_badge-line.is-top {
    top: -1px;
    left: -7px;
    right: -7px;
    height: 1px;
  }

  .sn_badge-line.is-bottom {
    bottom: -1px;
    left: -7px;
    right: -7px;
    height: 1px;
  }

  .sn_badge-line.is-left {
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 1px;
  }

  .sn_badge-line.is-right {
    right: -1px;
    top: -1px;
    bottom: -1px;
    width: 1px;
  }

  .sn_step-copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    max-width: 21.1875rem;
  }

  /* text-size-large on element provides Satoshi 1.25rem/1.4;
     override to Playfair + dark-primary + w600 for this section */
  .sn_step-heading {
    font-family: var(--_typography---h-root_size--primary-font);
    font-weight: 600;
    color: var(--color--text--dark--primary);
    margin: 0;
  }

  .sn_step-body {
    width: 100%;
    white-space: normal;
  }

  /* ---------- Polaroid Photo ---------- */
  .sn_polaroid {
    --sn-polaroid-rotate: 0deg;
    --sn-polaroid-translate-y: 0%;
    background-color: var(--brand--50);
    padding: 0.75rem 0.75rem 2rem;
    width: 15rem;
    flex-shrink: 0;
    position: absolute;
    top: 50%;
    z-index: 1;
    transform: translateY(var(--sn-polaroid-translate-y)) rotate(var(--sn-polaroid-rotate));
    box-shadow:
      1px 4px 10px rgba(90, 86, 43, 0.1),
      5px 17px 18px rgba(90, 86, 43, 0.09),
      12px 39px 24px rgba(90, 86, 43, 0.05);
  }

  .sn_polaroid.is-tilt-left {
    --sn-polaroid-rotate: -11deg;
  }

  .sn_polaroid.is-tilt-right {
    --sn-polaroid-rotate: 11deg;
  }

  .sn_step.is-step-1 .sn_polaroid,
  .sn_step.is-step-3 .sn_polaroid {
    left: -17rem;
    --sn-polaroid-translate-y: -50%;
  }

  .sn_step.is-step-2 .sn_polaroid {
    right: -17rem;
    --sn-polaroid-translate-y: -50%;
  }

  .sn_polaroid-tape {
    position: absolute;
    top: -18px;
    left: 50%;
    transform: translateX(-50%);
    width: 5rem;
    height: auto;
    z-index: 2;
    pointer-events: none;
  }

  .sn_polaroid-tape.is-step-1 {
    top: -13.5%;
    left: 52%;
    z-index: -10;
  }

  .sn_polaroid-tape.is-step-2 {
    top: -13.5%;
    left: 57%;
    z-index: -10;
  }

  .sn_polaroid-tape.is-step-3 {
    top: -13.5%;
    left: 59%;
    z-index: -10;
  }

  .sn_polaroid-image {
    background-color: white;
    width: 100%;
    height: 212px;
    overflow: hidden;
  }

  .sn_polaroid-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Desktop Step Layout ---------- */
  @media screen and (min-width: 992px) {
    .sn_steps-area {
      min-height: 1050px;
    }

    .sn_steps-list {
      padding-top: 10rem;
      gap: 4rem;
    }
  }

  /* ---------- Tablet (max-width: 991px) ---------- */
  @media screen and (max-width: 991px) {
    .sn_step.is-step-1 .sn_polaroid,
    .sn_step.is-step-3 .sn_polaroid {
      left: 0;
      --sn-polaroid-translate-y: 0;
    }

    .sn_step.is-step-2 .sn_polaroid {
      right: 0;
      --sn-polaroid-translate-y: 0;
    }
    .sn_path-title {
      width: calc(100% - 4rem);
      max-width: 37.5rem;
      top: 0;
      left: 50%;
      transform: translate(-50%, -50%);
      position: absolute;
    }

    .sn_trap-card,
    .sn_answer-card {
      max-width: 28.875rem;
    }

    .sn_trap-inner {
      padding: 1.5rem;
    }

    .sn_speech-row {
      flex-wrap: wrap;
    }

    .sn_speech-bubble {
      width: auto;
      flex: 1;
      min-width: 180px;
    }

    .sn_musashi {
      max-width: 100%;
    }

    .sn_steps-bg {
      width: 100%;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .sn_curves-svg {
      display: none;
    }

    .sn_curves-clip {
      display: none;
    }

    .sn_steps-list {
      max-width: 100%;
      padding: 6rem 0 2rem;
      gap: 2.5rem;
    }

    .sn_step {
      min-height: auto;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      text-align: center;
    }

    .sn_step-text {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      max-width: 100%;
    }

    .sn_step-copy {
      max-width: 100%;
      align-items: center;
    }

    .sn_step-heading,
    .sn_step-body {
      text-align: center;
    }

    .sn_polaroid {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      width: 12rem;
      margin: 0 auto;
      --sn-polaroid-translate-y: 0%;
    }

    .sn_polaroid-image {
      height: 10.5rem;
    }

    .sn_path-title-inner {
      padding: 1.5rem;
    }
  }

  /* ---------- Mobile Landscape (max-width: 767px) ---------- */
  @media screen and (max-width: 767px) {
    .sn_path-title {
      width: calc(100% - 4rem);
    }

    .sn_trap-card {
      padding-top: 1rem;
    }
    .sn_trap-inner,
    .sn_answer-card {
      padding: 1.25rem;
    }

    .sn_steps-bg {
      width: 100%;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .sn_vline {
      height: 40px;
    }

    .sn_steps-list {
      padding-top: 5rem;
      gap: 2rem;
    }

    .sn_polaroid {
      width: 11.25rem;
    }

    .sn_polaroid-image {
      height: 9.375rem;
    }
  }

  /* ---------- Mobile Portrait (max-width: 479px) ---------- */
  @media screen and (max-width: 479px) {
    .sn_path-title {
      width: calc(100% - 4rem);
      padding: 0.5rem;
    }
    .sn_trap-inner,
    .sn_answer-card {
      padding: 1rem;
      gap: 0.75rem;
    }

    .sn_speech-row {
      flex-direction: column;
      gap: 0.5rem;
    }

    .sn_speech-bubble {
      width: 100%;
      min-width: unset;
    }

    .sn_cycle-box {
      padding: 1rem;
    }

    .sn_polaroid {
      width: 10rem;
    }

    .sn_polaroid-image {
      height: 8.5rem;
    }

    .sn_steps-bg,
    .sn_answer-card {
      width: 100%;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
      border-left: none;
      border-right: none;
    }

    .sn_trap-card {
      width: 100%;
      max-width: 100%;
      border-left: none;
      border-right: none;
    }

    .sn_steps-list {
      gap: 4rem;
    }

    .sn_step-text {
      gap: 0.5rem;
    }

    .sn_path-title-inner {
      padding: 1rem;
    }

    .sn_panel-title {
      font-size: var(--_responsive---heading-size--h6);
      line-height: var(--_responsive---heading-line-height--h6);
    }
  }
</style>

<section class='section_stakes' data-sn-stakes-section>
  <div class='padding-global'>
    <div class='container-large is-line'>
      <div class='line-wrapper'>
        <div class='line-long'></div>
      </div>
      <div class='content-wrapper is-stakes'>
        <div class='spacer-xhuge'></div>

        {%- comment -%} ===== HEADING ===== {%- endcomment -%}
        <div class='stakes_header'>
          <div class='max-width-small'>
            <h2 class='heading-style-h3 text-align-center'>
              <span>
                You Showed Up Before.
                <br>
                Nothing Changed.
              </span>
            </h2>
          </div>
        </div>

        <div class='spacer-medium'></div>

        {%- comment -%} ===== THE OLD WAY ===== {%- endcomment -%}
        <div class='sn_trap-card' data-sn-width-target>
          <img
            src='{{ "corner_top-left.svg" | asset_url }}'
            loading='lazy'
            alt=''
            class='corner is-top-left'
          >
          <img
            src='{{ "corner_top-right.svg" | asset_url }}'
            loading='lazy'
            alt=''
            class='corner is-top-right'
          >
          <img
            src='{{ "corner_bottom-left.svg" | asset_url }}'
            loading='lazy'
            alt=''
            class='corner is-bottom-left'
          >
          <img
            src='{{ "corner_bottom-right.svg" | asset_url }}'
            loading='lazy'
            alt=''
            class='corner is-bottom-right'
          >
          <h3 class='heading-style-h6 is-stakes'>The Motivation Trap</h3>
          <div class='sn_trap-inner'>
            <p class='text-size-medium'>It always starts with the same promise.</p>

            <div class='stakes_list sn_trap-list'>
              <div class='stakes_list-item'>
                <div class='stakes_icon'>
                  <img
                    src='{{ "red-x-icon.svg" | asset_url }}'
                    loading='lazy'
                    alt=''
                    aria-hidden='true'
                    class='stakes_icon-info'
                  >
                </div>
                <p class='text-size-medium'>Then life got busy.</p>
              </div>

              <div class='stakes_list-item'>
                <div class='stakes_icon'>
                  <img
                    src='{{ "red-x-icon.svg" | asset_url }}'
                    loading='lazy'
                    alt=''
                    aria-hidden='true'
                    class='stakes_icon-info'
                  >
                </div>
                <p class='text-size-medium'>Motivation dropped.</p>
              </div>

              <div class='stakes_list-item'>
                <div class='stakes_icon'>
                  <img
                    src='{{ "red-x-icon.svg" | asset_url }}'
                    loading='lazy'
                    alt=''
                    aria-hidden='true'
                    class='stakes_icon-info'
                  >
                </div>
                <p class='text-size-medium'>
                  And you had
                  <strong>nothing to return to.</strong>
                </p>
              </div>
            </div>

            <p class='text-size-medium'>So you stopped.</p>

            <div class='sn_trap-note'>
              <p class='text-size-medium'>Not because you didn&rsquo;t care.</p>
              <p class='text-size-medium'>
                But because
                <strong>motivation without a path</strong>
                is a
                <span class='sn_inline-label is-trap'>TRAP</span>
              </p>
            </div>

            <div class='sn_cycle-box'>
              <p class='text-size-medium text-weight-bold text-align-center sn_cycle-copy'>
                Start &rarr; Stop &rarr; Guilt &rarr; Repeat
              </p>
            </div>
          </div>
        </div>

        {%- comment -%} ===== CONNECTOR ===== {%- endcomment -%}
        <svg
          class='sn_vline'
          viewBox='0 0 1 64'
          fill='none'
          preserveAspectRatio='none'
          xmlns='http://www.w3.org/2000/svg'
          aria-hidden='true'
        >
          <path class='sn_vline-path' d='M0.5 0V64' />
        </svg>

        {%- comment -%} ===== TRANSITION CARD ===== {%- endcomment -%}
        <div class='sn_answer-card'>
          <p class='text-size-medium text-weight-semibold text-align-center'>The answer is not more motivation.</p>
          <p class='text-size-medium text-align-center sn_answer-body'>
            It&rsquo;s a
            <span class='sn_inline-label is-path'>PATH</span>
            you can return to, even on bad days.
          </p>
        </div>
        <svg
          class='sn_vline'
          viewBox='0 0 1 64'
          fill='none'
          preserveAspectRatio='none'
          xmlns='http://www.w3.org/2000/svg'
          aria-hidden='true'
        >
          <path class='sn_vline-path' d='M0.5 0V64' />
        </svg>
        {%- comment -%} ===== CONNECTOR ===== {%- endcomment -%}
        <svg
          class='sn_vline'
          viewBox='0 0 1 64'
          fill='none'
          preserveAspectRatio='none'
          xmlns='http://www.w3.org/2000/svg'
          aria-hidden='true'
        >
          <path class='sn_vline-path' d='M0.5 0V64' />
        </svg>

        {%- comment -%} ===== THE MUSASHI WAY ===== {%- endcomment -%}

        <div class='sn_steps-bg'>
          <div class='sn_path-title' data-sn-width-source>
            <img
              src='{{ "corner_top-left.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-top-left'
            >
            <img
              src='{{ "corner_top-right.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-top-right'
            >
            <img
              src='{{ "corner_bottom-left.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-bottom-left'
            >
            <img
              src='{{ "corner_bottom-right.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-bottom-right'
            >

            <div class='sn_path-title-inner'>
              <h3 class='heading-style-h6 is-stakes'>The Musashi Path</h3>
            </div>
          </div>
          {%- comment -%} Connector curves (desktop only) {%- endcomment -%}
          <div class='sn_curves-clip' aria-hidden='true'>
            <svg
              class='sn_curves-svg'
              viewBox='0 0 669 1028'
              fill='none'
              preserveAspectRatio='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <path
                class='sn_curves-path'
                d='M319.426 0C319.426 87.04 366.602 147.386 319.426 193C243.926 266 5.92969 241 1.42665 369.023C-2.99563 494.751 95.9297 538.5 246.43 527.5C469.339 511.208 618.43 550 660.426 646.023C702.422 742.047 567.93 800 346.926 820.523C203.43 833.849 90.3626 858.095 41.4283 887C-21.5885 924.223 -6.57412 959 49.4267 1027.52'
              />
            </svg>
