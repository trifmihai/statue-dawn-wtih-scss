      "label": "Alt Text: step 1 image",
      "default": "Open manual beside a coffee cup showing the 5 Rings journey table of contents."
    },
    {
      "type": "text",
      "id": "alt_step_2",
      "label": "Alt Text: step 2 image",
      "default": "Hand writing inside the manual on a light surface."
    },
    {
      "type": "text",
      "id": "alt_step_3",
      "label": "Alt Text: step 3 image",
      "default": "Two people standing by a lake with their arms outstretched toward the mountains."
    }
  ],
  "presets": [
    {
      "name": "Section: Stakes Narrative"
    }
  ]
}
