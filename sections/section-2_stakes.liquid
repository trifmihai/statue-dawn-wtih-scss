            </div>
          </div>
          <div class='spacer-xhuge'></div>
        </div>
        <div class='line-wrapper'>
          <div class='line-long'></div>
        </div>
      </div>
    </div>
  </section>
{% endcomment %}

<style>
  /* =============================================
     Section: Stakes Narrative (section-2-1)
     Layout-only CSS - typography, spacing, buttons,
     corners, and shared wrappers reuse global classes
     ============================================= */

  .sn_layout {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .sn_section-title {
    font-weight: 600;
    line-height: 1.333;
    text-transform: none;
  }

  /* New component: motivation-trap card - no existing section matched this composition */
  .sn_trap-card {
    background-color: var(--neutral--100);
    border: 1px solid var(--neutral--400);
    width: 100%;
    max-width: 32.625rem;
    padding: 1.5rem 0.75rem 0.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .sn_panel-title {
    color: var(--color--text--dark--primary);
    font-family: var(--_typography---h-root_size--primary-font);
    font-size: var(--_responsive---heading-size--h5);
    line-height: var(--_responsive---heading-line-height--h5);
    font-weight: 600;
    text-align: center;
    margin: 0;
  }

  .sn_trap-inner {
    width: 100%;
    background-color: var(--neutral--0);
    border: 1px solid var(--neutral--300);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .sn_trap-list {
    gap: 0.25rem;
    align-items: stretch;
  }

  .sn_trap-item-copy {
    flex: 1;
  }

  .sn_trap-note {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }

  /* New highlight labels: unique inline callouts from the Figma design */
  .sn_inline-label {
    display: inline-flex;
    align-items: center;
    padding: 0 0.25rem;
    color: var(--color--text--dark--primary);
    font-weight: 600;
  }

  .sn_inline-label.is-trap {
    background-color: #fdc6c2;
  }

  .sn_inline-label.is-path {
    background-color: var(--brand--100);
  }

  .sn_cycle-box {
    width: 100%;
    background-color: var(--neutral--0);
    border: 1px solid var(--neutral--300);
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: center;
  }

  .sn_cycle-copy {
    color: #9c4a44;
  }

  .sn_connector {
    width: 0;
    height: 4rem;
    border-left: 1px dashed var(--brand--500);
    opacity: 0.75;
  }

  .sn_answer-card {
    width: 100%;
    max-width: 28.875rem;
    background-color: var(--neutral--0);
    border: 1px solid var(--neutral--400);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .sn_answer-body {
    white-space: normal;
  }

  /* New component: pinned-photo Musashi path stage - no existing section matched this layout */
  .sn_path-stage {
    width: 100%;
    max-width: 67.875rem;
    min-height: 69.6875rem;
    position: relative;
  }

  .sn_path-board {
    position: absolute;
    top: 4.0625rem;
    left: 50%;
    transform: translateX(-50%);
    width: 49.9375rem;
    height: 65.625rem;
    background-color: #fdfdfb;
    border: 1px solid var(--brand--300);
    z-index: 0;
  }

  .sn_path-title {
    width: 37.5rem;
    padding: 0.75rem;
    background-color: var(--brand--50);
    border: 1px solid var(--brand--300);
    box-shadow: 0 1px 2px rgba(34, 34, 34, 0.05);
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
  }

  .sn_path-title-inner {
    width: 100%;
    background-color: var(--neutral--0);
    border: 1px solid var(--brand--500);
    padding: 2rem;
    position: relative;
  }

  .sn_path-curves {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .sn_path-curve {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sn_path-curve-asset {
    display: block;
    max-width: none;
  }

  .sn_path-curve.is-1 {
    top: 5.91875rem;
    left: 12.331875rem;
    width: 22.7381875rem;
    height: 12.2369375rem;
  }

  .sn_path-curve.is-1 .sn_path-curve-asset {
    width: 2.6795625rem;
    height: 23.7474375rem;
    transform: rotate(65.64deg);
  }

  .sn_path-curve.is-2 {
    top: 25.6425rem;
    left: 15.1875rem;
    width: 38.5625rem;
    height: 8.7896875rem;
  }

  .sn_path-curve.is-2 .sn_path-curve-asset {
    width: 1.949875rem;
    height: 38.859rem;
    transform: rotate(100.28deg);
  }

  .sn_path-curve.is-3 {
    top: 38.3925rem;
    left: 13.225625rem;
    width: 38.36825rem;
    height: 17.46475rem;
  }

  .sn_path-curve.is-3 .sn_path-curve-asset {
    width: 4.71959375rem;
    height: 39.0684375rem;
    transform: rotate(-109.56deg);
  }

  .sn_path-steps {
    width: 21.75rem;
    margin-top: 18.25rem;
    margin-left: 23.0625rem;
    display: flex;
    flex-direction: column;
    gap: 10.9375rem;
    position: relative;
    z-index: 2;
  }

  .sn_path-row {
    width: 100%;
    position: relative;
  }

  .sn_path-step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
  }

  .sn_step-badge {
    width: 2rem;
    min-width: 2rem;
    height: 2rem;
    background-color: var(--brand--50);
    border: 1px solid var(--neutral--400);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sn_step-badge span {
    position: relative;
    z-index: 1;
  }

  .sn_badge-line {
    position: absolute;
    background-color: var(--brand--500);
  }

  .sn_badge-line.is-top {
    top: -1px;
    left: -7px;
    right: -7px;
    height: 1px;
  }

  .sn_badge-line.is-bottom {
    bottom: -1px;
    left: -7px;
    right: -7px;
    height: 1px;
  }

  .sn_badge-line.is-left {
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 1px;
  }

  .sn_badge-line.is-right {
    right: -1px;
    top: -1px;
    bottom: -1px;
    width: 1px;
  }

  .sn_path-step-copy {
    width: 18.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .sn_path-step-title {
    margin: 0;
    color: var(--color--text--dark--primary);
    font-family: var(--_typography---h-root_size--primary-font);
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 600;
  }

  .sn_path-step-body {
    white-space: normal;
    justify-content: flex-start;
    align-items: flex-start;
    text-align: left;
  }

  .sn_path-photo {
    width: 15rem;
    background-color: var(--brand--50);
    padding: 0.75rem 0.75rem 2rem;
    position: absolute;
    box-shadow:
      1px 4px 10px rgba(90, 86, 43, 0.1),
      5px 17px 18px rgba(90, 86, 43, 0.09),
      12px 39px 24px rgba(90, 86, 43, 0.05);
  }

  .sn_path-photo.is-step-1 {
    top: -2.625rem;
    left: -21.625rem;
    transform: rotate(-11deg);
  }

  .sn_path-photo.is-step-2 {
    top: -8.0625rem;
    left: 27.375rem;
    transform: rotate(11deg);
  }

  .sn_path-photo.is-step-3 {
    top: -2.1875rem;
    left: -21.625rem;
    transform: rotate(-11deg);
  }

  .sn_path-photo-pin {
    width: 2.5rem;
    height: auto;
    position: absolute;
    top: -1.875rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    pointer-events: none;
  }

  .sn_path-photo-image {
    width: 100%;
    height: 13.25rem;
    background-color: var(--neutral--0);
    overflow: hidden;
  }

  .sn_path-photo-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 991px) {
    .sn_section-title {
      line-height: 1.25;
    }

    .sn_trap-card,
    .sn_answer-card {
      max-width: 100%;
    }

    .sn_trap-inner {
      padding: 1.5rem;
    }

    .sn_path-stage {
      min-height: auto;
      padding: 5.5rem 1.5rem 1.5rem;
      background-color: #fdfdfb;
      border: 1px solid var(--brand--300);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .sn_path-board,
    .sn_path-curves {
      display: none;
    }

    .sn_path-title {
      width: calc(100% - 3rem);
      max-width: 37.5rem;
      top: 0;
      left: 50%;
      transform: translate(-50%, -50%);
      position: absolute;
    }

    .sn_path-title-inner {
      padding: 1.5rem;
    }

    .sn_path-steps {
      width: 100%;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .sn_path-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .sn_path-photo {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      margin: 0 auto;
    }

    .sn_path-step {
      width: 100%;
      max-width: 21.75rem;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      text-align: center;
    }

    .sn_path-step-copy {
      width: 100%;
      align-items: center;
    }

    .sn_path-step-body {
      text-align: center;
      align-items: center;
    }
  }

  @media screen and (max-width: 767px) {
    .sn_layout {
      gap: 2rem;
    }

    .sn_trap-card {
      padding-top: 1rem;
    }

    .sn_trap-inner,
    .sn_answer-card {
      padding: 1.25rem;
    }

    .sn_cycle-box {
      padding: 1rem 1.25rem;
    }

    .sn_connector {
      height: 3rem;
    }

    .sn_path-stage {
      padding: 5rem 1rem 1.25rem;
    }

    .sn_path-title {
      width: calc(100% - 2rem);
    }

    .sn_path-photo {
      width: 12rem;
      padding: 0.75rem 0.75rem 1.5rem;
    }

    .sn_path-photo-image {
      height: 10.5rem;
    }
  }

  @media screen and (max-width: 479px) {
    .sn_panel-title {
      font-size: var(--_responsive---heading-size--h6);
      line-height: var(--_responsive---heading-line-height--h6);
    }

    .sn_trap-inner,
    .sn_answer-card {
      padding: 1rem;
    }

    .sn_path-stage {
      padding: 4.75rem 0.75rem 1rem;
    }

    .sn_path-title {
      width: calc(100% - 1.5rem);
      padding: 0.5rem;
    }

    .sn_path-title-inner {
      padding: 1rem;
    }

    .sn_path-photo {
      width: 10.5rem;
      padding: 0.625rem 0.625rem 1.25rem;
    }

    .sn_path-photo-image {
      height: 9rem;
    }
  }
</style>

<section class='section_stakes'>
  <div class='padding-global'>
    <div class='container-large is-line'>
      <div class='line-wrapper'>
        <div class='line-long'></div>
      </div>
      <div class='content-wrapper is-stakes'>
        <div class='spacer-xhuge'></div>

        <div class='sn_layout'>
          <div class='stakes_header'>
            <div class='max-width-medium'>
              <h2 class='heading-style-h3 text-align-center sn_section-title'>
                You Showed Up Before.
                <br>
                Nothing Changed.
              </h2>
            </div>
          </div>

          <div class='sn_trap-card'>
            <img
              src='{{ "corner_top-left.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-top-left'
            >
            <img
              src='{{ "corner_top-right.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-top-right'
            >
            <img
              src='{{ "corner_bottom-left.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-bottom-left'
            >
            <img
              src='{{ "corner_bottom-right.svg" | asset_url }}'
              loading='lazy'
              alt=''
              aria-hidden='true'
              class='corner is-bottom-right'
            >

            <h3 class='sn_panel-title'>The Motivation Trap</h3>

            <div class='sn_trap-inner'>
              <p class='text-size-medium'>It always starts with the same promise.</p>

              <div class='stakes_list sn_trap-list'>
                <div class='stakes_list-item'>
                  <div class='stakes_icon'>
                    <img
                      src='{{ "red-x-icon.svg" | asset_url }}'
                      loading='lazy'
                      alt=''
                      aria-hidden='true'
                      class='stakes_icon-info'
                    >
                  </div>
                  <p class='text-size-medium sn_trap-item-copy'>Then life got busy.</p>
                </div>

                <div class='stakes_list-item'>
                  <div class='stakes_icon'>
                    <img
                      src='{{ "red-x-icon.svg" | asset_url }}'
                      loading='lazy'
                      alt=''
                      aria-hidden='true'
                      class='stakes_icon-info'
                    >
                  </div>
                  <p class='text-size-medium sn_trap-item-copy'>Motivation dropped.</p>
                </div>

                <div class='stakes_list-item'>
                  <div class='stakes_icon'>
                    <img
                      src='{{ "red-x-icon.svg" | asset_url }}'
                      loading='lazy'
                      alt=''
                      aria-hidden='true'
                      class='stakes_icon-info'
                    >
                  </div>
                  <p class='text-size-medium sn_trap-item-copy'>
                    And you had
                    <strong>nothing to return to.</strong>
                  </p>
                </div>
              </div>

              <p class='text-size-medium'>So you stopped.</p>

              <div class='sn_trap-note'>
                <p class='text-size-medium'>Not because you didn&rsquo;t care.</p>
                <p class='text-size-medium'>
                  But because
                  <strong>motivation without a path</strong>
                  is a
                  <span class='sn_inline-label is-trap'>TRAP</span>
                </p>
              </div>

              <div class='sn_cycle-box'>
                <p class='text-size-medium text-weight-bold text-align-center sn_cycle-copy'>
                  Start &rarr; Stop &rarr; Guilt &rarr; Repeat
                </p>
              </div>
            </div>
          </div>

          <div class='sn_connector' aria-hidden='true'></div>

          <div class='sn_answer-card'>
            <p class='text-size-medium text-weight-semibold text-align-center'>The answer is not more motivation.</p>
            <p class='text-size-medium text-align-center sn_answer-body'>
              It&rsquo;s a
              <span class='sn_inline-label is-path'>PATH</span>
              you can return to, even on bad days.
            </p>
          </div>

          <div class='sn_connector' aria-hidden='true'></div>

          <div class='sn_path-stage'>
            <div class='sn_path-board' aria-hidden='true'></div>

            <div class='sn_path-title'>
              <img
                src='{{ "corner_top-left.svg" | asset_url }}'
                loading='lazy'
                alt=''
                aria-hidden='true'
                class='corner is-top-left'
              >
              <img
                src='{{ "corner_top-right.svg" | asset_url }}'
                loading='lazy'
                alt=''
                aria-hidden='true'
                class='corner is-top-right'
              >
              <img
                src='{{ "corner_bottom-left.svg" | asset_url }}'
                loading='lazy'
                alt=''
                aria-hidden='true'
                class='corner is-bottom-left'
              >
              <img
                src='{{ "corner_bottom-right.svg" | asset_url }}'
                loading='lazy'
                alt=''
                aria-hidden='true'
                class='corner is-bottom-right'
              >

              <div class='sn_path-title-inner'>
                <h3 class='sn_panel-title'>The Musashi Path</h3>
              </div>
            </div>

            <div class='sn_path-curves' aria-hidden='true'>
              <div class='sn_path-curve is-1'>
                <img
                  src='{{ "stakes_curve_1.svg" | asset_url }}'
                  loading='lazy'
                  alt=''
                  class='sn_path-curve-asset'
                >
              </div>
              <div class='sn_path-curve is-2'>
                <img
                  src='{{ "stakes_curve_2.svg" | asset_url }}'
                  loading='lazy'
                  alt=''
                  class='sn_path-curve-asset'
                >
              </div>
              <div class='sn_path-curve is-3'>
                <img
                  src='{{ "stakes_curve_3.svg" | asset_url }}'
                  loading='lazy'
                  alt=''
                  class='sn_path-curve-asset'
                >
              </div>
            </div>

            <div class='sn_path-steps'>
              <div class='sn_path-row is-step-1'>
                <div class='sn_path-photo is-step-1'>
                  <img
                    src='{{ "pin.webp" | asset_url }}'
                    loading='lazy'
                    alt=''
                    aria-hidden='true'
                    class='sn_path-photo-pin'
                  >
                  <div class='sn_path-photo-image'>
                    <img
                      src='{{ "step_1_image.png" | asset_url }}'
                      loading='lazy'
                      alt='{{ section.settings.alt_step_1 }}'
                    >
                  </div>
                </div>

                <div class='sn_path-step'>
                  <div class='sn_step-badge'>
                    <span class='text-size-regular text-weight-semibold'>1</span>
                    <div class='sn_badge-line is-top'></div>
                    <div class='sn_badge-line is-bottom'></div>
                    <div class='sn_badge-line is-left'></div>
                    <div class='sn_badge-line is-right'></div>
                  </div>

                  <div class='sn_path-step-copy'>
                    <h4 class='sn_path-step-title'>Start with clear direction.</h4>
                    <p class='text-size-regular sn_path-step-body'>
                      No vague promises. Just a clear next step, so each day gives you something to follow and return
                      to.
                    </p>
                  </div>
                </div>
              </div>

              <div class='sn_path-row is-step-2'>
                <div class='sn_path-photo is-step-2'>
                  <img
                    src='{{ "pin.webp" | asset_url }}'
                    loading='lazy'
                    alt=''
                    aria-hidden='true'
                    class='sn_path-photo-pin'
                  >
                  <div class='sn_path-photo-image'>
                    <img
                      src='{{ "step_2_image.png" | asset_url }}'
                      loading='lazy'
                      alt='{{ section.settings.alt_step_2 }}'
                    >
                  </div>
                </div>

                <div class='sn_path-step'>
                  <div class='sn_step-badge'>
                    <span class='text-size-regular text-weight-semibold'>2</span>
                    <div class='sn_badge-line is-top'></div>
                    <div class='sn_badge-line is-bottom'></div>
                    <div class='sn_badge-line is-left'></div>
                    <div class='sn_badge-line is-right'></div>
                  </div>

                  <div class='sn_path-step-copy'>
                    <h4 class='sn_path-step-title'>Build belief through proof.</h4>
                    <p class='text-size-regular sn_path-step-body'>
                      <strong>Guided notes make progress visible</strong>
                      by capturing what you did, what resisted, and what changed.
                    </p>
                  </div>
                </div>
              </div>

              <div class='sn_path-row is-step-3'>
                <div class='sn_path-photo is-step-3'>
                  <img
                    src='{{ "pin.webp" | asset_url }}'
                    loading='lazy'
                    alt=''
                    aria-hidden='true'
                    class='sn_path-photo-pin'
                  >
                  <div class='sn_path-photo-image'>
                    <img
                      src='{{ "step_3_image.png" | asset_url }}'
                      loading='lazy'
                      alt='{{ section.settings.alt_step_3 }}'
                    >
                  </div>
                </div>

                <div class='sn_path-step'>
                  <div class='sn_step-badge'>
                    <span class='text-size-regular text-weight-semibold'>3</span>
                    <div class='sn_badge-line is-top'></div>
                    <div class='sn_badge-line is-bottom'></div>
                    <div class='sn_badge-line is-left'></div>
                    <div class='sn_badge-line is-right'></div>
                  </div>

                  <div class='sn_path-step-copy'>
                    <h4 class='sn_path-step-title'>Break free from The Trap.</h4>
                    <p class='text-size-regular sn_path-step-body'>
                      <strong>The path keeps you moving,</strong>
                      so one bad day won&rsquo;t drag you back into the same old loop anymore.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class='button-group'>
            <div class='button-wrapper'>
              <a href='#section-pricing' class='button is-default w-inline-block'>
                <div class='button_line is-top'></div>
                <div class='button_content'>
                  <div class='text-size-regular is-primary'>{{ settings.cta_primary }}</div>
                </div>
                <div class='button_line is-bottom'></div>
              </a>
            </div>
          </div>
        </div>

        <div class='spacer-xhuge'></div>
      </div>
      <div class='line-wrapper'>
        <div class='line-long'></div>
      </div>
    </div>
  </div>
</section>

