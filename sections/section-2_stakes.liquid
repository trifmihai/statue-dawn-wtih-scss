<section class='section_stakes'>
  <div class='padding-global'>
    <div class='container-large is-line'>
      <div class='line-wrapper'>
        <div class='line-long'></div>
      </div>
      <div class='content-wrapper is-stakes'>
        <div class='spacer-xhuge'></div>
        <div class='stakes_header'>
          <div class='max-width-medium'>
            <h2 class='heading-style-h3 text-align-center'>
              <span>Motivation is a Lie.</span>
            </h2>
          </div>
          <div data-figma-id='8779:19264' class='stakes_body'>
            <div class='max-width-small'>
              <p class='text-size-medium text-align-center'>
                You don’t need to "feel" like doing it. You need a system that executes regardless of how you feel.
              </p>
            </div>
          </div>
        </div>
        <div class='spacer-large'></div>
        <div class='stakes_container'>
          <div data-figma-id='8814:23461' class='stakes_item is-first'>
            <div data-figma-id='8814:23462' class='stakes_item-content'>
              <div class="stakes_item-headline">
                <p class='text-size-large is-stakes'>Old Way</p>
                <h3 data-figma-id='8814:23464' class='heading-style-h6 is-stakes'>
                  The Motivation Trap
                </h3>
              </div>
              <div data-figma-id='8814:23465' class='stakes_list'>
                <div data-figma-id='8814:23466' class='stakes_list-item'>
                  <div data-figma-id='8814:23467' class='stakes_icon'>
                    <img
                      src={{ 'red-x-icon.svg' | asset_url }}
                      loading='lazy'
                      alt=''
                      class='stakes_icon-info'>
                  </div>
                  <p class='text-size-regular'>
                    <strong>Dopamine Chasing:</strong>
                    Most people watch a video, get pumped, grind for 3 days, and burn out by Wednesday.
                  </p>
                </div>
                <div data-figma-id='8814:23474' class='stakes_list-item'>
                  <div data-figma-id='8814:23475' class='stakes_icon'>
                    <img
                      src={{ 'red-x-icon.svg' | asset_url }}
                      loading='lazy'
                      alt=''
                      class='stakes_icon-info'>
                  </div>
                  <p class='text-size-regular'>

                    <strong>The Guilt Spiral:</strong>
                    Most people think perfection is the only option. One missed day and they quit.
                  </p>
                </div>
                <div data-figma-id='8814:23482' class='stakes_list-item'>
                  <div data-figma-id='8814:23483' class='stakes_icon'>
                    <img
                      src={{ 'red-x-icon.svg' | asset_url }}
                      loading='lazy'
                      alt=''
                      class='stakes_icon-info'>
                  </div>
                  <p class='text-size-regular'>
                    <strong>Emotional Dependency:</strong>
                    Most people wait to feel "inspired". If the mood isn't right, nothing gets done.
                  </p>

                </div>
              </div>
            </div>
            <img
              src={{ 'corner_top-left.svg' | asset_url }}
              loading='lazy'
              alt=''
              class='corner is-top-left'>
            <img
              src={{ 'corner_bottom-left.svg' | asset_url }}
