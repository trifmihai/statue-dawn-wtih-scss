              alt=''
              class='corner is-bottom-left hide-on-mobile'>
            <img
              src={{ 'corner_top-right.svg' | asset_url }}
              loading='lazy'
              alt=''
              class='corner is-top-right is-mobile'>
          </div>
          <div data-figma-id='8814:23461' class='stakes_item is-last'>
            <div data-figma-id='8814:23462' class='stakes_item-content'>
              <div class="stakes_item-headline">
                <p class='text-size-large is-stakes'>Musashi Way</p>
                <h3 data-figma-id='8814:23464' class='heading-style-h6 is-stakes'>
                  The Disciplined Mind
                </h3>
              </div>
              <div data-figma-id='8814:23465' class='stakes_list'>
                <div data-figma-id='8814:23466' class='stakes_list-item'>
                  <div data-figma-id='8814:23467' class='stakes_icon'>
                    <img
                      src={{ 'check-circle.svg' | asset_url }}
                      loading='lazy'
                      alt=''
                      class='stakes_icon-info'>
                  </div>
                  <p class='text-size-regular'>
                    <strong>Clarity:</strong>
                    The protocol gives you a step-by-step roadmap. You never wake up wondering "what to do next?"
                  </p>
                </div>
                <div data-figma-id='8814:23474' class='stakes_list-item'>
                  <div data-figma-id='8814:23475' class='stakes_icon'>
                    <img
                      src={{ 'check-circle.svg' | asset_url }}
                      loading='lazy'
                      alt=''
                      class='stakes_icon-info'>
                  </div>
                  <p class='text-size-regular'>
                    <strong>Progress:</strong>
                    The system is designed to keep you moving. You trade the "all-or-nothing" grind for stackable wins.
                  </p>
                </div>
                <div data-figma-id='8814:23482' class='stakes_list-item'>
                  <div data-figma-id='8814:23483' class='stakes_icon'>
                    <img
                      src={{ 'check-circle.svg' | asset_url }}
                      loading='lazy'
                      alt=''
                      class='stakes_icon-info'>
                  </div>
                  <p class='text-size-regular'>
                    <strong>Automatic Discipline:</strong>
                    You stop negotiating with yourself and become the person who follows through.
                  </p>
                </div>
              </div>
