                  <div data-figma-id='8814:23482' class='stakes_list-item'>
                    <div data-figma-id='8814:23483' class='stakes_icon'>
                      <img
                        src={{ 'check-circle.svg' | asset_url }}
                        loading='lazy'
                        alt=''
