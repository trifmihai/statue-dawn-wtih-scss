<section class='section_interactive'>
  <div class='padding-global'>
    <div class='container-large is-line'>
      <div class='line-wrapper'>
        <div class='line-long'></div>
      </div>
      <div class='content-wrapper is-interactive'>
        <div class='spacer-xhuge'></div>
        <div class='interactive_header'>
          <div class='max-width-medium'>
            <h2 class='heading-style-h3 text-align-center'>
              <span>See What’s Inside The Musashi Manual</span>
            </h2>
          </div>
          <div class='interactive_body'>
            <div class='max-width-small'>
              <p class='text-size-medium text-align-center'>
                Simple to log. Designed to stack wins and build proof you’re changing.
              </p>
            </div>
          </div>
        </div>
        <div class='spacer-medium'></div>
        <div class='interactive_manual-wrapper' data-sn-manual-root>
          <div class='interactive_container'>
            <div class='interactive_item'>
              <div class='interactive_item-content'>
                <div class='interactive_item-headline'>
                  <p class='text-size-medium is-uppercase'>Fill in the pages</p>
                </div>
                <label class='interactive_toggle'>
                  <input type='checkbox' class='interactive_toggle-input' data-sn-manual-toggle>
                  <span class='interactive_toggle-track'>
                    <span class='interactive_toggle-thumb'></span>
                  </span>
                </label>
              </div>
              <img
                src='{{ 'corner_top-left.svg' | asset_url }}'
                loading='lazy'
                alt=''
                class='corner is-top-left'
              >
              <img
                src='{{ 'corner_bottom-left.svg' | asset_url }}'
                loading='lazy'
                alt=''
                class='corner is-bottom-left'
              >
              <img
                src='{{ 'corner_top-right.svg' | asset_url }}'
                loading='lazy'
                alt=''
                class='corner is-top-right'
              >

              <img
                src='{{ 'corner_bottom-right.svg' | asset_url }}'
                loading='lazy'
                alt=''
                class='corner is-bottom-right'
              >
            </div>
          </div>
          <div class='max-width-large interactive_manual-hit-area' data-sn-manual-hit-area>
            <div class='interactive_manual-images'>
              <picture>
                <source
                  media='(max-width: 991px)'
                  srcset='{{ 'open-manual-empty-mobile.webp' | asset_url }}'
                >
                <img
                  src='{{ 'open-manual-empty.webp' | asset_url }}'
                  loading='lazy'
                  alt=''
                  class='interactive_manual'
                  data-sn-manual-base
                >
              </picture>
              <svg
                class='interactive_manual-overlay'
                data-sn-manual-reveal-svg
                viewBox='0 0 100 100'
                preserveAspectRatio='none'
                aria-hidden='true'
              >
                  <defs>
                    <radialGradient data-sn-manual-mask-gradient cx='50%' cy='50%' r='50%'>
                      <stop offset='0%' stop-color='white' stop-opacity='1'></stop>
                      <stop offset='44%' stop-color='white' stop-opacity='1'></stop>
                      <stop offset='62%' stop-color='white' stop-opacity='0.98'></stop>
                      <stop offset='78%' stop-color='white' stop-opacity='0.82'></stop>
                      <stop offset='92%' stop-color='white' stop-opacity='0.22'></stop>
                      <stop offset='100%' stop-color='white' stop-opacity='0'></stop>
                    </radialGradient>
                    <radialGradient data-sn-manual-halo-gradient cx='50%' cy='50%' r='50%'>
                      <stop offset='0%' stop-color='#fff7e2' stop-opacity='0.68'></stop>
                      <stop offset='48%' stop-color='#f8e7bc' stop-opacity='0.2'></stop>
                      <stop offset='100%' stop-color='#f8e7bc' stop-opacity='0'></stop>
                    </radialGradient>
                    <mask
                      data-sn-manual-mask
                      x='0'
                      y='0'
                      width='100'
                      height='100'
                      maskUnits='userSpaceOnUse'
                      maskContentUnits='userSpaceOnUse'
                    >
                      <rect x='0' y='0' width='100' height='100' fill='black'></rect>
                      <ellipse
                        data-sn-manual-mask-shape
                        cx='50'
                        cy='50'
                        rx='10.5'
                        ry='9'
                        fill='white'
                      ></ellipse>
                    </mask>
                  </defs>
                  <image
                    data-sn-manual-fill-image
                    data-sn-manual-fill-desktop-src='{{ 'open-manual-fill.png' | asset_url }}'
                    data-sn-manual-fill-mobile-src='{{ 'open-manual-fill-mobile.webp' | asset_url }}'
                    href='{{ 'open-manual-fill.png' | asset_url }}'
                    width='100'
                    height='100'
                    preserveAspectRatio='none'
                  ></image>
                  <ellipse
                    class='interactive_manual-halo'
                    data-sn-manual-halo-shape
                    cx='50'
                    cy='50'
                    rx='14'
                    ry='12.5'
                    fill='white'
                  ></ellipse>
              </svg>
            </div>
          </div>
        </div>
        <div class='spacer-medium'></div>
        <div class='button-group'>
          <div class='button-wrapper'>
            {% render 'cta-button', href: '#section-pricing', text: settings.cta_primary %}
          </div>
        </div>
        <div class='spacer-xhuge'></div>
      </div>
      <div class='line-wrapper'>
        <div class='line-long'></div>
      </div>
    </div>
  </div>
</section>
