{% stylesheet %}
  .section_plan .sword-asset {
    --sword-offset-x: 0px;
    --sword-offset-y: 0px;
    --sword-tilt: 0deg;
    --sword-scale: 0.55;
    --sword-base-rot: 27deg;
    transform: translate3d(var(--sword-offset-x), var(--sword-offset-y), 0) scale(var(--sword-scale))
      rotate(calc(var(--sword-base-rot) + var(--sword-tilt)));
    transform-origin: bottom left;
    will-change: transform;
    backface-visibility: hidden;
  }

  .section_plan .sword-asset.is-week-5 {
    --sword-scale: 0.6;
    --sword-base-rot: 26deg;
  }

  .section_plan .sword-asset.is-beyond {
    --sword-scale: 0.6;
    --sword-base-rot: 22deg;
  }

  @media screen and (max-width: 767px) {
    .section_plan .sword-asset {
      --sword-scale: 0.5;
      --sword-base-rot: 27deg;
    }

    .section_plan .sword-asset.is-week-5 {
      --sword-scale: 0.55;
      --sword-base-rot: 23deg;
    }

    .section_plan .sword-asset.is-beyond {
      --sword-scale: 0.55;
      --sword-base-rot: 20deg;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.section_plan');
    if (!section) return;

    var supportsFineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!supportsFineHover || reduceMotion) return;

    var swords = Array.prototype.slice.call(section.querySelectorAll('.sword-asset'));
    if (!swords.length) return;

    var PROXIMITY_PADDING = 130;
    var MOVE_RANGE_X = 8.8;
    var MOVE_RANGE_Y = 6.2;
    var ROTATION_RANGE = 4.9;
    var SPRING = 0.16;
    var DAMPING = 0.78;
    var POINTER_IMPULSE_X = 0.18;
    var POINTER_IMPULSE_Y = 0.13;
    var POINTER_IMPULSE_ROT = 0.7;
    var POINTER_VELOCITY_DECAY = 0.82;

    var pointerX = 0;
    var pointerY = 0;
    var hasPointer = false;
    var rafId = null;
    var lastTime = performance.now();
    var lastPointerX = 0;
    var lastPointerY = 0;
    var hasPointerHistory = false;
    var pointerVelocityX = 0;
    var pointerVelocityY = 0;

    var states = swords.map(function (sword) {
      return {
        sword: sword,
        offsetX: 0,
        offsetY: 0,
        rotation: 0,
        velocityX: 0,
        velocityY: 0,
        velocityRotation: 0,
        targetX: 0,
        targetY: 0,
        targetRotation: 0,
      };
    });

    function clamp(value, min, max) {
      if (value < min) return min;
      if (value > max) return max;
      return value;
    }

    function updateTargets() {
      if (!hasPointer) {
        states.forEach(function (state) {
          state.targetX = 0;
          state.targetY = 0;
          state.targetRotation = 0;
          state.sword.classList.remove('is-proximity-active');
        });
        return;
      }

      states.forEach(function (state) {
        var rect = state.sword.getBoundingClientRect();
        var inProximity =
          pointerX >= rect.left - PROXIMITY_PADDING &&
          pointerX <= rect.right + PROXIMITY_PADDING &&
          pointerY >= rect.top - PROXIMITY_PADDING &&
          pointerY <= rect.bottom + PROXIMITY_PADDING;

        if (!inProximity) {
          state.targetX = 0;
          state.targetY = 0;
          state.targetRotation = 0;
          state.sword.classList.remove('is-proximity-active');
          return;
        }

        state.sword.classList.add('is-proximity-active');

        var pivotX = rect.left + rect.width * 0.18;
        var pivotY = rect.bottom - rect.height * 0.1;
        var rangeX = rect.width * 0.95 + PROXIMITY_PADDING * 0.5;
        var rangeY = rect.height * 0.95 + PROXIMITY_PADDING * 0.5;
        var nx = clamp((pointerX - pivotX) / rangeX, -1, 1);
        var ny = clamp((pointerY - pivotY) / rangeY, -1, 1);
        var distance = Math.sqrt(nx * nx + ny * ny);
        var influence = clamp(1 - distance, 0, 1);

        var localX = clamp((pointerX - rect.left) / rect.width, 0, 1);
        var localY = clamp((rect.bottom - pointerY) / rect.height, 0, 1);
        var bladeWeight = clamp(localX * 0.6 + localY * 0.5, 0, 1);

        var movementSensitivity = 0.48 + bladeWeight * 0.4;
        var rotationSensitivity = 0.58 + bladeWeight * 0.75;
        var impulseSensitivity = 0.42 + bladeWeight * 0.65;

        var magnetX = nx * MOVE_RANGE_X * (0.4 + influence) * movementSensitivity;
        var magnetY = ny * MOVE_RANGE_Y * (0.32 + influence * 0.85) * movementSensitivity;
        var magnetRotation = (nx * ROTATION_RANGE + ny * -2.4) * rotationSensitivity;

        state.targetX = magnetX + pointerVelocityX * POINTER_IMPULSE_X * influence * impulseSensitivity;
        state.targetY = magnetY + pointerVelocityY * POINTER_IMPULSE_Y * influence * impulseSensitivity;
        state.targetRotation =
          magnetRotation +
          (pointerVelocityX * POINTER_IMPULSE_ROT + pointerVelocityY * -0.35) * influence * impulseSensitivity;
      });
    }

    function applySpring(deltaFactor) {
      var settled = true;
      var dampingFactor = Math.pow(DAMPING, deltaFactor);

      states.forEach(function (state) {
        var accelX = (state.targetX - state.offsetX) * SPRING;
        var accelY = (state.targetY - state.offsetY) * SPRING;
        var accelRotation = (state.targetRotation - state.rotation) * (SPRING + 0.03);

        state.velocityX = (state.velocityX + accelX * deltaFactor) * dampingFactor;
        state.velocityY = (state.velocityY + accelY * deltaFactor) * dampingFactor;
        state.velocityRotation = (state.velocityRotation + accelRotation * deltaFactor) * dampingFactor;

        state.offsetX += state.velocityX * deltaFactor;
        state.offsetY += state.velocityY * deltaFactor;
        state.rotation += state.velocityRotation * deltaFactor;

        state.sword.style.setProperty('--sword-offset-x', state.offsetX.toFixed(2) + 'px');
        state.sword.style.setProperty('--sword-offset-y', state.offsetY.toFixed(2) + 'px');
        state.sword.style.setProperty('--sword-tilt', state.rotation.toFixed(2) + 'deg');

        var deltaX = Math.abs(state.targetX - state.offsetX);
        var deltaY = Math.abs(state.targetY - state.offsetY);
        var deltaRotation = Math.abs(state.targetRotation - state.rotation);

        if (
          deltaX > 0.02 ||
          deltaY > 0.02 ||
          deltaRotation > 0.02 ||
          Math.abs(state.velocityX) > 0.02 ||
          Math.abs(state.velocityY) > 0.02 ||
          Math.abs(state.velocityRotation) > 0.02
        ) {
          settled = false;
        }
      });

      if (Math.abs(pointerVelocityX) > 0.02 || Math.abs(pointerVelocityY) > 0.02) {
        settled = false;
      }

      return settled;
    }

    function tick(now) {
      updateTargets();

      var deltaFactor = Math.min(2, (now - lastTime) / 16.67);
      lastTime = now;

      pointerVelocityX *= Math.pow(POINTER_VELOCITY_DECAY, deltaFactor);
      pointerVelocityY *= Math.pow(POINTER_VELOCITY_DECAY, deltaFactor);

      if (Math.abs(pointerVelocityX) < 0.01) pointerVelocityX = 0;
      if (Math.abs(pointerVelocityY) < 0.01) pointerVelocityY = 0;

      if (applySpring(deltaFactor)) {
        rafId = null;
        return;
      }

      rafId = requestAnimationFrame(tick);
    }

    function startLoop() {
      if (rafId) return;
      lastTime = performance.now();
      rafId = requestAnimationFrame(tick);
    }

    function onPointerMove(event) {
      var nextPointerX = event.clientX;
      var nextPointerY = event.clientY;

      if (hasPointerHistory) {
        pointerVelocityX = clamp(nextPointerX - lastPointerX, -30, 30);
        pointerVelocityY = clamp(nextPointerY - lastPointerY, -30, 30);
      } else {
        pointerVelocityX = 0;
        pointerVelocityY = 0;
        hasPointerHistory = true;
      }

      lastPointerX = nextPointerX;
      lastPointerY = nextPointerY;

      pointerX = event.clientX;
      pointerY = event.clientY;
      hasPointer = true;
      startLoop();
    }

    function onPointerLeave() {
      hasPointer = false;
      hasPointerHistory = false;
      pointerVelocityX = 0;
      pointerVelocityY = 0;
      startLoop();
    }

    section.addEventListener('pointerenter', onPointerMove, { passive: true });
    section.addEventListener('pointermove', onPointerMove, { passive: true });
    section.addEventListener('pointerleave', onPointerLeave);
    section.addEventListener('pointercancel', onPointerLeave);
  });
{% endjavascript %}

