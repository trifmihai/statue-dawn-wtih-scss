<section class='section_plan'>
  <div class='padding-global'>
    <div class='container-large is-line'>
      <div class='line-wrapper is-desktop'>
        <div class='line-long'></div>
        <div class='line-short'></div>
        <div class='line-long'></div>
      </div>
      <div class='line-wrapper is-mobile'>
        <div class='line-long is-mobile'></div>
        <div class='line-wrapper is-desktop'>
          <div class='line-long'></div>
          <div class='line-short'></div>
          <div class='line-long'></div>
        </div>
        <div class='line-wrapper is-desktop'>
          <div class='line-long'></div>
          <div class='line-short'></div>
          <div class='line-long'></div>
        </div>
      </div>
      <div class='content-wrapper is-plan'>
        <div class='spacer-xhuge'></div>
        <div class='plan_header'>
          <div class='max-width-medium'>
            <h2 class='heading-style-h3 text-align-center'>
              <span>The 5-Rings Battle Plan</span>
            </h2>
          </div>
          <div class='plan_body'>
            <div class='max-width-small'>
              <p class='text-size-medium text-align-center'>
                Most people fail because they try to do everything at once. This protocol uses "Progressive Overload" to build your discipline layer by layer.
              </p>
            </div>
          </div>
        </div>
        <div class='spacer-xlarge'></div>
        <div class='plan_content'>
          <div class='plan_step-component'>
            <div class='plan_tag'>
              <div class='plan_tag-line is-top'></div>
              <div class='plan_tag-content'>
                <div class='text-size-regular text-weight-semibold is-plan'>Day 1</div>
              </div>
              <div class='plan_tag-line is-bottom'></div>
            </div>
            <div class='plan_card-wrapper'>
              <img
                src={{ 'sword-day-1.webp' | asset_url }}
                loading='lazy'
                alt="{{ section.settings.alt_sword_day_1 }}"
                class='sword-asset is-day-1'>
              <div class='plan_card-content'>
                <div class='plan_card-header'>
                  <div class="plan_title-wrapper">
                    <h3 class='text-size-large is-plan'>The Purge
                    </h3>
                    <h4 class="text-size-medium plan-span_title">(The Clarity Protocol)</h4>
                  </div>
                  <p class='text-size-regular'>

                    <strong>You subtract noise.</strong>
                    You identify the specific "anchors" holding you back
                    <span>(phone addiction, toxic habits)</span>
                    and cut the dead weight immediately.</p>
                </div>
              </div>
            </div>
          </div>
          <div class='plan_lines-wrapper'>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
          </div>
          <div class='plan_step-component'>
            <div class='plan_tag'>
              <div class='plan_tag-line is-top'></div>
              <div class='plan_tag-content'>
                <div class='text-size-regular text-weight-semibold is-plan'>Week 1-2</div>
              </div>
              <div class='plan_tag-line is-bottom'></div>
            </div>
            <div class='plan_card-wrapper'>
              <img
                src={{ 'sword-week-1.webp' | asset_url }}
                loading='lazy'
                alt="{{ section.settings.alt_sword_week_1 }}"
                class='sword-asset is-week-1'>
              <div class='plan_card-content'>
                <div class='plan_card-header'>
                  <div class="plan_title-wrapper">
                    <h3 class='text-size-large is-plan'>The Foundation
                    </h3>
                    <h4 class="text-size-medium plan-span_title">(Earth & Water Rings)</h4>
                  </div>

                  <p class='text-size-regular'>

                    <strong>You stop negotiating with your mind.
                    </strong>
                    You stack small, undeniable wins every day and learn to flow around obstacles rather then quitting when life gets hard.

                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class='plan_lines-wrapper'>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
          </div>
          <div class='plan_step-component'>
            <div class='plan_tag'>
              <div class='plan_tag-line is-top'></div>
              <div class='plan_tag-content'>
                <div class='text-size-regular text-weight-semibold is-plan'>Week 3-5</div>
              </div>
              <div class='plan_tag-line is-bottom'></div>
            </div>
            <div class='plan_card-wrapper'>
              <img
                src={{ 'sword-week-5.webp' | asset_url }}
                loading='lazy'
                alt="{{ section.settings.alt_sword_week_5 }}"
                class='sword-asset is-week-5'>
              <div class='plan_card-content'>
                <div class='plan_card-header'>
                  <div class="plan_title-wrapper">
                    <h3 class='text-size-large is-plan'>The Intensity
                    </h3>
                    <h4 class="text-size-medium plan-span_title">(Fire & Wind Rings)</h4>
                  </div>
                  <p class='text-size-regular'>

                    <strong>Channel aggression into output.</strong>
                    You learn to detach from the chaos around you. The actions that felt "hard" on Day 1 now feel automatic.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class='plan_lines-wrapper'>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
            <div class='plan_line'></div>
          </div>
          <div class='plan_step-component'>
            <div class='plan_tag'>
              <div class='plan_tag-line is-top'></div>
              <div class='plan_tag-content'>
                <div class='text-size-regular text-weight-semibold is-plan'>Week 5+</div>
              </div>
              <div class='plan_tag-line is-bottom'></div>
            </div>
            <div class='plan_card-wrapper is-beyond'>
              <img
                src={{ 'sword-beyond.webp' | asset_url }}
                loading='lazy'
                alt="{{ section.settings.alt_sword_beyond }}"
                class='sword-asset is-beyond'>
              <div class='plan_card-content'>
                <div class='plan_card-header'>
                  <div class="plan_title-wrapper">
                    <h3 class='text-size-large is-plan'>Identity Shift
                    </h3>
                    <h4 class="text-size-medium plan-span_title">(Void Ring & Beyond)</h4>
                  </div>
                  <p class='text-size-regular'>

                    <strong>Total Integration.</strong>
                    Discipline stops being something you do. It becomes who you are. You reach the state of
 
 
 
 
 
 
 
 
                    action without thought.
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>
        <div class='plan_mountain-wrapper'>
          <img
            src="{{ 'mountain-x1.webp' | asset_url }}"
            loading="lazy"
            sizes="100vw"
            srcset="
    {{ 'mountain-x1-p-500.webp' | asset_url }} 500w,
    {{ 'mountain-x1-p-800.webp' | asset_url }} 800w,
    {{ 'mountain-x1-p-1080.webp' | asset_url }} 1080w,
    {{ 'mountain-x1.webp' | asset_url }} 1222w
  "
            alt="{{ section.settings.alt_mountain_x1 }}"
            class="plan_mountain-asset" />
        </div>
        <div class='spacer-xhuge'></div>
      </div>
      <div class='line-wrapper is-desktop'>
        <div class='line-long'></div>
        <div class='line-short'></div>
        <div class='line-long'></div>
      </div>
      <div class='line-wrapper is-mobile'>
        <div class='line-long is-mobile'></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Section: Plan",
    "settings": [
      {
        "type": "text",
        "id": "alt_sword_day_1",
        "label": "Alt Text: sword-day-1",
        "default": "Vertical wooden sword with metal bracket near the bottom signifying day 1."
      },
      {
        "type": "text",
        "id": "alt_sword_week_1",
        "label": "Alt Text: sword-week-1",
        "default": "A worn, straight-edged katana sword with a dark handle wrapped in black cord signifying week 1."
      },
      {
        "type": "text",
        "id": "alt_sword_week_5",
        "label": "Alt Text: sword-week-5",
        "default": "Japanese katana sword with a curved, sharp blade and a black wrapped handle signifying week 5."
      },
      {
        "type": "text",
        "id": "alt_sword_beyond",
        "label": "Alt Text: sword-beyond",
        "default": "Ceremonial sword with a curved, polished blade and ornate handle wrapped in dark cord signifying beyond week 5."
      }, {
        "type": "text",
        "id": "alt_mountain_x1",
        "label": "Alt Text: mountain-x1",
        "default": "Monochrome digital artwork of multiple snow-covered mountains with sharp peaks fading into the mist signifying discipline journey and how far they've come."
      }
    ],
    "presets": [
      {
        "name": "Section: Plan"
      }
    ]
  }
{% endschema %}