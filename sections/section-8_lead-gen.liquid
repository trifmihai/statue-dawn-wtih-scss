<section id='section-lead-gen' class='section_lead-gen'>
  <div class='padding-global'>
    <div class='container-large is-line'>
      <div class='mid-line'></div>
      <div class='content-wrapper is-lead-gen'>
        <div class='spacer-xhuge'></div>
        <div class='lead-gen_container'>
          <div class='lead-gen_header'>
            <div class='lead-gen_description'>
              <div class='lead-gen_title'>
                <div class='max-width-medium'>
                  <h2 class='heading-style-h3 is-cta-headline'>
                    <span>Still on the fence?</span>
                  </h2>
                </div>
                <div class='max-width-small'>
                  <p class='text-size-medium is-lead-gen-subtitle'>
                    Start with a curated 33-page free sample of The Digital Protocol. Here&rsquo;s what&rsquo;s inside:
                  </p>
                </div>
              </div>
              <div class='lead-gen_item-group'>
                <div class='lead-gen_items'>
                  <img
                    class='lead-gen_icon-check is-centered'
                    src='{{ 'pricing-check-circle.svg' | asset_url }}'
                    data-figma-image-id='67c9c1a7c28acae30c9fd52f'
                    alt=''
                    data-figma-id='8924:7649'
                    data-figma-image-hash='b8ef57f3e6b74588c85bc307fbf9d39e'
                    loading='lazy'
                  >
                  <p data-figma-id='8716:32190' class='text-size-medium'>
                    <strong>Protocol Preview:</strong>
                    understand how it works
                  </p>
                </div>
                <div class='lead-gen_items'>
                  <img
                    class='lead-gen_icon-check is-centered'
                    src='{{ 'pricing-check-circle.svg' | asset_url }}'
                    data-figma-image-id='67c9c1a7c28acae30c9fd52f'
                    alt=''
                    data-figma-id='8924:7649'
                    data-figma-image-hash='b8ef57f3e6b74588c85bc307fbf9d39e'
                    loading='lazy'
                  >
                  <p data-figma-id='8716:32190' class='text-size-medium'>
                    <strong>Actionable Steps:</strong>
                    get a taste of the Earth & Fire Rings
                  </p>
                </div>
                <div class='lead-gen_items'>
                  <img
                    class='lead-gen_icon-check'
                    src='{{ 'pricing-check-circle.svg' | asset_url }}'
                    data-figma-image-id='67c9c1a7c28acae30c9fd52f'
                    alt=''
                    data-figma-id='8924:7649'
                    data-figma-image-hash='b8ef57f3e6b74588c85bc307fbf9d39e'
                    loading='lazy'
                  >
                  <p data-figma-id='8716:32190' class='text-size-medium'>
                    <strong>The Notion Tracker:</strong>
                    log your first victories
                  </p>
                </div>
              </div>
            </div>
            <div data-figma-id='8814:23461' class='lead-gen_item is-hide-on-desktop'>
              <div data-figma-id='8814:23462' class='lead-gen_item-content'>
                <img
                  src='{{ 'lead-generator-mockup.webp' | asset_url }}'
                  loading='lazy'
                  sizes='100vw'
                  srcset='{{ 'lead-generator-mockup-p-500.webp' | asset_url }} 500w, {{ 'lead-generator-mockup-p-800.webp' | asset_url }} 800w, {{ 'lead-generator-mockup-p-1080.webp' | asset_url }} 1080w, {{ 'lead-generator-mockup.webp' | asset_url }} 1146w'
                  alt=''
                  class='lead-gen_asset'
                >
              </div>
              {% render 'section-corners' %}
            </div>
            <div class='form w-form'>
              <form
                id='email-form'
                name='mc-embedded-subscribe-form'
                data-name='Email Form'
                data-mailchimp-form
                method='post'
                action='https://shelbymedialtd.us20.list-manage.com/subscribe/post?u=5097958bce3377c0c230d6991&amp;id=1e11c3eda5&amp;f_id=003330eef0'
                class='lead-gen_form'
                data-wf-page-id='67e1854c2284fc148a18b800'
                data-wf-element-id='30205ab1-eee6-c5c5-d96f-5a2695e0f0a9'
              >
                <div class='form_fields-container'>
                  {% comment %}
                    <div class='form_name-wrapper'>
                                                                                     <div class='form_field-wrapper'>
                      <label for='mce-LNAME' class='field-label'>Last Name</label>
                      <input
                        class='form-input w-input'
                        maxlength='256'
                        name='LNAME'
                        data-name='Last Name'
                        placeholder=''
                        type='text'
                        id='mce-LNAME'
                        required=''>
                    </div>
                                                                </div>
                  {% endcomment %}

                  <div class='form_field-wrapper'>
                    <label for='mce-FNAME' class='field-label'>Name</label>
                    <input
                      class='form-input w-input'
                      maxlength='256'
                      name='FNAME'
                      data-name='First Name'
                      placeholder=''
                      type='text'
                      id='mce-FNAME'
                      required=''
                    >
                  </div>

                  <div class='form_field-wrapper'>
                    <label for='mce-EMAIL' class='field-label'>Email Address</label>
                    <input
                      class='form-input w-input'
                      maxlength='256'
                      name='EMAIL'
                      data-name='Email'
                      placeholder=''
                      type='email'
                      id='mce-EMAIL'
                      required=''
                    >
                  </div>
                </div>
                <div aria-hidden='true' class='visually-hidden'>
                  <input
                    type='text'
                    name='b_5097958bce3377c0c230d6991_1e11c3eda5'
                    tabindex='-1'
                    value=''
                  >
                </div>
                <div class='button is-default'>
                  <div class='button_line is-bottom'></div>
                  <input
                    type='submit'
                    data-wait='Please wait...'
                    class='button is-form w-button'
                    value='Send My FREE Protocol'
                  >
                  <div class='button_line is-top'></div>
                </div>
              </form>
              <div class='success-message w-form-done'>
                <div class='success-message_container'>
                  <div class='success-message_item'>
                    <div class='success-message_item-content'>
                      <p class='text-size-medium'>
                        <strong>Success!</strong>
                        {{ settings.lead_gen_success }}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <div class='error-message w-form-fail'>
                <div>Oops! Something went wrong while submitting the form.</div>
              </div>
            </div>
          </div>
          <div data-figma-id='8814:23461' class='lead-gen_item is-hide-on-mobile'>
            <div data-figma-id='8814:23462' class='lead-gen_item-content'>
              <img
                src='{{ 'lead-generator-mockup.webp' | asset_url }}'
                loading='lazy'
                sizes='100vw'
                srcset='{{ 'lead-generator-mockup-p-500.webp' | asset_url }} 500w, {{ 'lead-generator-mockup-p-800.webp' | asset_url }} 800w, {{ 'lead-generator-mockup-p-1080.webp' | asset_url }} 1080w, {{ 'lead-generator-mockup.webp' | asset_url }} 1146w'
                alt='{{ section.settings.alt_lead_generator_mockup }}'
                class='lead-gen_asset'
              >
            </div>
            {% render 'section-corners' %}
          </div>
        </div>
        <div class='spacer-medium'></div>
        <div class='spacer-xhuge'></div>
      </div>
      <div class='mid-line'></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Section: Lead Gen",
  "settings": [
    {
      "type": "text",
      "id": "alt_lead_generator_mockup",
      "label": "Alt Text: lead-generator-mockup",
      "default": "Two pages from a the book, featuring what's inside the free pack. Includes a Notion app icon and text reading 'Secret Bonus Inside'."
    }
  ],
  "presets": [
    {
      "name": "Section: Lead Gen"
    }
  ]
}
{% endschema %}
